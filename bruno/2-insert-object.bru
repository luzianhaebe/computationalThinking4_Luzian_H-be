meta {
  name: POST /objects
  type: http
  seq: 2
}

post {
  url: http://localhost:3001/objects
  body: json
  auth: none
}

body:json {
  {
    "id": "bruno-note",
    "type": "sticky-note",
    "x": 120,
    "y": 120,
    "width": 192,
    "height": 192,
    "text": "Hello from Bruno",
    "color": "yellow",
    "fontSize": 18,
    "bold": false
  }
}

assert {
  res.status: eq 201
  res.body.id: eq bruno-note
}

docs {
  Creates the object: 201, afterwards it is in backend/data/board.json.
  Send it a second time: 409, because the id already exists.
}
